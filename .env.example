# Base URL of the Kinvo REST API, including /api/v1.
# Anything prefixed VITE_ ships to the browser in plain text: never put a secret here.
#
# Production (set in Vercel, Production scope):
#   VITE_API_BASE_URL=https://dm9o5kgscmnxv.cloudfront.net/api/v1
#
# Local development: either a local backend (CORS_ORIGINS=* there)...
#   VITE_API_BASE_URL=http://localhost:3000/api/v1
# ...or the deployed API through Vite's dev proxy (production CORS refuses localhost):
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=https://dm9o5kgscmnxv.cloudfront.net
